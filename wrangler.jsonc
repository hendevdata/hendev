{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hendev",
	"main": "worker.js",
	"compatibility_date": "2026-04-22",
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "single-page-application"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "MESSAGES_KV",
			"id": "61c0b646ab82414fa271375eb0d5f550"
		}
	],
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	]
}